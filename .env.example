# ---------------------------------------------------------------------------
# Integración con el API REST de Eden (middleware)
# Documentación: https://docs-middleware.edenmed.com/
#
# Copia este archivo como .env.local para desarrollo y captura los mismos
# valores en Vercel → Settings → Environment Variables.
# Ninguna de estas variables lleva el prefijo NEXT_PUBLIC_: el token sólo se
# usa en el servidor y nunca llega al navegador.
# ---------------------------------------------------------------------------

# URL base del API, incluyendo /api/v1
#   Pruebas:    https://middleware-staging.dev-land.space/api/v1
#   Producción: la que entregue el equipo de Eden al validar la integración
EDEN_API_URL=https://middleware-staging.dev-land.space/api/v1

# Token de autenticación. Se envía como "Authorization: Token <valor>".
# Es un secreto: no lo subas al repositorio.
EDEN_API_TOKEN=

# Segundo factor opcional. En "true" la página pide también la fecha de
# nacimiento del paciente y sólo muestra el estudio si coincide con Eden.
# Recomendado en producción para que un folio por sí solo no exponga datos.
EDEN_REQUIRE_BIRTH_DATE=false

# Tiempo máximo de espera por petición a Eden, en milisegundos.
EDEN_API_TIMEOUT_MS=12000
