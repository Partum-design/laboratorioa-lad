# ---------------------------------------------------------------------------
# Integración con el API REST de Eden (middleware)
# Documentación: https://docs-middleware.edenmed.com/
#
# Copia este archivo como .env.local para desarrollo y captura los mismos
# valores en Vercel → Settings → Environment Variables.
# Ninguna de estas variables lleva el prefijo NEXT_PUBLIC_: el token sólo se
# usa en el servidor y nunca llega al navegador.
# ---------------------------------------------------------------------------

# URL base del API, incluyendo /api/v1
#   Pruebas:    https://middleware-staging.dev-land.space/api/v1
#   Producción: https://middleware.evacenter.com/api/v1   ← verificada en vivo
EDEN_API_URL=https://middleware.evacenter.com/api/v1

# Token de autenticación. Se envía como "Authorization: Token <valor>".
# Es un secreto: no lo subas al repositorio.
EDEN_API_TOKEN=

# Sucursal del laboratorio: el `external_identifier` que Eden asigna a la
# facility. En producción es "matriz". Sólo se muestran los estudios de esta
# sucursal; vacío desactiva el filtro y acepta cualquiera.
# El filtro se aplica sobre los resultados, no en la petición: el API ignora
# `?facility_identifier=` y `?facility=` espera el UUID interno, no este valor.
EDEN_FACILITY_IDENTIFIER=matriz

# Segundo factor opcional. En "true" la página pide también la fecha de
# nacimiento del paciente y sólo muestra el estudio si coincide con Eden.
# Endurece la privacidad, pero desactiva el respaldo para estudios que sólo
# existen en el PACS (sin orden en Eden no hay fecha contra la cual comparar).
EDEN_REQUIRE_BIRTH_DATE=false

# Tiempo máximo de espera por petición a Eden, en milisegundos.
EDEN_API_TIMEOUT_MS=12000

# Meses hacia atrás que recorre la búsqueda. Eden no admite rangos de más de un
# mes por petición, así que cada mes es una petición más (la primera del minuto;
# después responde el caché). Por el caché el costo es de N peticiones por minuto
# para todo el sitio, no por paciente, pero la cuota de Eden es de 10 por minuto
# compartidas: no conviene acercarse a ese número.
EDEN_SEARCH_MONTHS=4

# Órdenes que se traen por mes. Es el tope de lo que se puede encontrar: si el
# laboratorio genera más órdenes al mes que este número, las más antiguas del
# rango quedan fuera de la búsqueda.
EDEN_PAGE_LIMIT=500

# ---------------------------------------------------------------------------
# Chatbot con IA (Google Gemini)
# Consigue tu llave en https://aistudio.google.com/apikey
# Secreto: no lleva NEXT_PUBLIC_, sólo se usa en /api/chat (servidor).
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Pago en línea (Mercado Pago)
# Credenciales en https://www.mercadopago.com.mx/developers/panel/app
# El Access Token es secreto (servidor); la Public Key es pública y viaja al
# navegador para dibujar el formulario de tarjeta, por eso lleva NEXT_PUBLIC_.
# Mientras falten, la página /pago-en-linea muestra un enlace de WhatsApp en
# su lugar en vez de fallar.
# ---------------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
